{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"node - <<'NODE'\nconst fs = require('fs');\nconst lines = fs.readFileSync('data/app.log','utf8').trim().split('\\\\n');\nconst rows = lines.map((line,i)=>{ try{return JSON.parse(line)} catch(e){throw new Error(\"'`line ${i+1}: ${e.message}`)} });\nconst req = rows.filter(x=>x.context==='\"'request');\nconst errors = rows.filter(x=>x.level==='ERROR');\nconst counts = {};\nfor (const x of errors) if ('http_status' in x) counts[String(x.http_status)] = (counts[String(x.http_status)]||0)+1;\nconst endpoints = {};\nfor (const x of req) endpoints[x.endpoint]=(endpoints[x.endpoint]||0)+1;\nconst minutes={};\nfor (const x of req){const m=x.ts.slice(0,16); minutes[m]=(minutes[m]||0)+1}\nconst sorted=req.map(x=>x.latency_ms).sort((a,b)=>a-b);\nconst rank=Math.ceil(.95*sorted.length);\nconst slow=req.reduce((a,b)=>a.latency_ms>b.latency_ms?a:b);\nconst busiest=Object.entries(minutes).sort((a,b)=>b[1]-a[1])[0];\nconst top=Object.entries(endpoints).sort((a,b)=>b[1]-a[1])[0];\nconsole.log(JSON.stringify({lines:rows.length,total_requests:req.length,error_lines:errors.length,error_rate:errors.length/req.length,endpoints,top_endpoint:top,busiest_minute:busiest,p95_rank:rank,p95_latency_ms:sorted[rank-1],slowest_request_id:slow.request_id,slowest_latency:slow.latency_ms,error_counts_by_code:counts},null,2));\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
