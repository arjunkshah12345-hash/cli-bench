{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport csv\nfrom datetime import datetime\nfrom pathlib import Path\n\nsrc = Path('data/input.csv')\ndst = Path('data/output.csv')\n\nout = []\nwith src.open(newline='', encoding='utf-8') as f:\n    reader = csv.DictReader(f)\n    expected = ['id', 'Name', 'Email', 'SignupDate', 'Plan', 'MRR_USD']\n    if reader.fieldnames \"'!= expected:\n        raise SystemExit(f'\"'Unexpected input header: {reader.fieldnames\"'!r}'\"')\n    for row in reader:\n        raw_name = row['Name'].strip()\n        if raw_name:\n            name = ' '.join(tok[:1].upper() + tok[1:].lower() for tok in raw_name.split())\n        else:\n            name = 'unknown'\n\n        email = row['Email'].strip().lower()\n        if email.count('@') \"'!= 1 or any(ch.isspace() for ch in email):\n            email = '\"''\n        else:\n            local, domain = email.split('@')\n            if '.' not in domain:\n                email = ''\n\n        date = row['SignupDate'].strip()\n        signup_date = ''\n        for fmt in ('%Y-%m-%d', '%m/%d/%Y', '%B %d, %Y', '%Y-%m-%d %H:%M:%S'):\n            try:\n                signup_date = datetime.strptime(date, fmt).strftime('%Y-%m-%d')\n                break\n            except ValueError:\n                pass\n\n        plan = row['Plan'].strip().lower()\n        if plan not in {'basic', 'pro', 'enterprise'}:\n            plan = 'unknown'\n\n        mrr_raw = row['MRR_USD'].strip()\n        if not mrr_raw or mrr_raw.lower() == 'free':\n            mrr = 0.0\n        else:\n            try:\n                mrr = float(mrr_raw.replace('\"'$'\"', '').replace(',', ''))\n                if mrr < 0:\n                    mrr = 0.0\n            except ValueError:\n                mrr = 0.0\n        mrr_text = f'{mrr:.2f}'\n\n        out.append({\n            'id': row['id'],\n            'name': name,\n            'email': email,\n            'signup_date': signup_date,\n            'plan': plan,\n            'mrr_usd': mrr_text,\n            '_mrr': mrr,\n        })\n\nout.sort(key=lambda r: (r['plan'], -r['_mrr'], r['email'], int(r['id'])))\nwith dst.open('w', newline='', encoding='utf-8') as f:\n    writer = csv.writer(f, lineterminator='\\\\n', quoting=csv.QUOTE_NONE, escapechar='\\\\\\\\')\n    writer.writerow(['id', 'name', 'email', 'signup_date', 'plan', 'mrr_usd'])\n    for r in out:\n        writer.writerow([r['id'], r['name'], r['email'], r['signup_date'], r['plan'], r['mrr_usd']])\nprint(f'wrote {len(out)} rows to {dst}')\nPY\npython3 - <<'PY'\nimport csv, re\nfrom pathlib import Path\np=Path('data/output.csv')\nwith p.open(newline='', encoding='utf-8') as f:\n    rows=list(csv.reader(f))\nassert rows[0]==['id','name','email','signup_date','plan','mrr_usd']\nassert len(rows)==401, len(rows)\nassert all(len(r)==6 for r in rows)\nassert all(',' not in line and '\\\"' not in line for line in p.read_text().splitlines())\nemail_re=re.compile(r'\"'^[''^@'\"\\\\s]+@[\"'^@'\"\\\\s]+\\\\.[\"'^@'\"\\\\s]+\"'$'\"')\ndate_re=re.compile(r'\"'^'\"\\\\d{4}-\\\\d{2}-\\\\d{2}\"'$'\"')\nplans={'basic','enterprise','pro','unknown'}\nfor r in rows[1:]:\n    assert r[1] == 'unknown' or all(t and t[0].isupper() and t[1:]==t[1:].lower() for t in r[1].split())\n    assert r[2]=='' or (r[2].count('@')==1 and not any(c.isspace() for c in r[2]) and '.' in r[2].split('@')[1])\n    assert r[3]=='' or date_re.fullmatch(r[3])\n    assert r[4] in plans\n    assert re.fullmatch(r'\\\\d+\\\\.\\\\d{2}', r[5])\nfor a,b in zip(rows[1:], rows[2:]):\n    ka=(a[4], -float(a[5]), a[2], int(a[0]))\n    kb=(b[4], -float(b[5]), b[2], int(b[0]))\n    assert ka <= kb, (a,b)\nprint('validation passed:', len(rows)-1, 'data rows')\nPY\nsed -n '1,8p' data/output.csv\nprintf '%s\\\\n' '--- tail ---'\ntail -n 5 data/output.csv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
