{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nimport random, time\nfrom matrix_ops import count_pairs_within\ncfg={'uniform':(3400,.3),'clustered':(2600,.7),'gridded':(2200,.8)}\nrng=random.Random(12345)\nfor kind,(n,r) in cfg.items():\n    if kind=='uniform': pts=[(rng.random()*100,rng.random()*100) for _ in range(n)]\n    elif kind=='clustered':\n        centers=[(rng.random()*10,rng.random()*10) for _ in range(5)]\n        pts=[(cx+rng.gauss(0,.15),cy+rng.gauss(0,.15)) for cx,cy in (centers[i%5] for i in range(n))]\n    else:\n        side=int(n**.5); pts=[(i%side*1.0,i//side*1.0) for i in range(side*side)]\n    t=time.perf_counter(); ans=count_pairs_within(pts,r); dt=time.perf_counter()-t\n    print(kind,n,ans,dt)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
