{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport random, time\nfrom matrix_ops import count_pairs_within\n\ndef naive(points, r):\n    count=0; r2=r*r\n    for i,(x,y) in enumerate(points):\n        for j in range(i+1,len(points)):\n            dx=points[j][0]-x; dy=points[j][1]-y\n            if dx*dx+dy*dy <= r2: count += 1\n    return count\n\nrng=random.Random(12345)\nconfigs=[('uniform',3400,.3),('clustered',2600,.7),('gridded',2200,.8)]\nfor kind,n,r in configs:\n    if kind=='uniform': pts=[(rng.random()*100,rng.random()*100) for _ in range(n)]\n    elif kind=='clustered':\n        centers=[(rng.random()*10,rng.random()*10) for _ in range(5)]\n        pts=[(centers[i%5][0]+rng.gauss(0,.15),centers[i%5][1]+rng.gauss(0,.15)) for i in range(n)]\n    else:\n        side=int(n**.5); pts=[(float(i%side),float(i//side)) for i in range(side*side)]\n    t=time.perf_counter(); expected=naive(pts,r); old=time.perf_counter()-t\n    t=time.perf_counter(); actual=count_pairs_within(pts,r); new=time.perf_counter()-t\n    print(f'{kind}: {expected=} {actual=} old={old:.4f}s new={new:.4f}s speedup={old/new:.1f}x')\n\n# Random differential testing, including negative and zero radii.\nfor n in range(0, 35):\n    for _ in range(100):\n        pts=[(rng.uniform(-5,5),rng.uniform(-5,5)) for _ in range(n)]\n        if n and rng.random() < .2: pts += [pts[rng.randrange(n)]] * rng.randrange(1,4)\n        r=rng.choice([0.0, -0.0, .1, .7, -1.3, 10.0])\n        a=naive(pts,r); b=count_pairs_within(pts,r)\n        assert a == b, (pts,r,a,b)\nprint('random differential checks: ok')\nPY\npytest -q\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
