href=\"javascript:alert(4)\">click</a>',\n]\n\n\ndef test_script_payload_is_neutralized(tmp_path, monkeypatch):\n    monkeypatch.setattr(app, \"STORE\", tmp_path / \"comments.json\")\n    html = _render_with(PAYLOADS[0])\n    assert \"<script>\" not in html\n    assert \"alert\" not in _executable_parts(html)\n\n\ndef test_img_onerror_is_neutralized(tmp_path, monkeypatch):\n    monkeypatch.setattr(app, \"STORE\", tmp_path / \"comments.json\")\n    html = _render_with(PAYLOADS[1])\n    assert \"<img\" not in html\n    assert \"onerror\" not in _executable_parts(html)\n\n\ndef test_svg_onload_is_neutralized(tmp_path, monkeypatch):\n    monkeypatch.setattr(app, \"STORE\", tmp_path / \"comments.json\")\n    html = _render_with(PAYLOADS[2])\n    assert \"<svg\" not in html\n\n\ndef test_plain_text_survives(tmp_path, monkeypatch):\n    monkeypatch.setattr(app, \"STORE\", tmp_path / \"comments.json\")\n    app.add_comment(\"ana\", \"fish & chips <3 \\\"quoted\\\" 'single'\")\n    html = app.render_page()\n    # visible text must still show the characters (escaped is fine)\n    assert \"fish\" in html and \"chips\" in html\n    assert \"ana\" in html\n\n\ndef test_innocuous_comment_renders():\n    c = {\"author\": \"ana\", \"body\": \"great post!\"}\n    html = app.render_comment(c)\n    assert \"great post!\" in html\n    assert \"ana\" in html\n\n\ndef _render_with(payload):\n    app.add_comment(\"mallory\", payload)\n    return app.render_page()\n\n\ndef _executable_parts(html):\n    \"\"\"Rough check: no raw markup tags from user content may survive.\"\"\"\n\n    # after correct escaping, no user-controlled <tag> may remain.\n    # We look for the payload markers in raw form.\n    return html\n","exit_code":0,"status":"completed"}}
