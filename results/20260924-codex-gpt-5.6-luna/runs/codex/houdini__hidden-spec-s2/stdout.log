{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"node - <<'NODE'\nconst fs = require('fs');\nconst lines = fs.readFileSync('data/transactions.csv','utf8').trim().split(/\\\\r?\\\\n/).filter(x=>\"'!x.startsWith('\"'#'));\nconst rows = lines.slice(1).map(line=>{const [ts,merchant,amount,fee]=line.split(','); return {ts:+ts,merchant,amount:+amount,fee:+fee};});\nconst m = new Map();\nfor (const r of rows) {\n  let x=m.get(r.merchant); if(\"'!x) x={merchant:r.merchant,transaction_count:0,total_volume:0,net_total:0,first:r.ts,last:r.ts};\n  x.transaction_count++; x.total_volume += Math.abs(r.amount); x.net_total += r.amount-r.fee; x.first=Math.min(x.first,r.ts); x.last=Math.max(x.last,r.ts); m.set(r.merchant,x);\n}\nconst out=[...m.values()].map(x=>({merchant:x.merchant,transaction_count:x.transaction_count,total_volume:+x.total_volume.toFixed(2),net_total:+x.net_total.toFixed(2),first_ts:new Date(x.first*1000).toISOString().replace('\"'.000Z','Z'),last_ts:new Date(x.last*1000).toISOString().replace('.000Z','Z')})).sort((a,b)=>b.net_total-a.net_total||a.merchant.localeCompare(b.merchant));\nconsole.log(JSON.stringify(out,null,2));\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
