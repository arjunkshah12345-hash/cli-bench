{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport csv\nfrom datetime import datetime\nfrom pathlib import Path\n\nsrc = Path('data/input.csv')\ndst = Path('data/output.csv')\n\nformats = ('%Y-%m-%d', '%m/%d/%Y', '%B %d, %Y', '%Y-%m-%d %H:%M:%S')\nvalid_plans = {'basic', 'pro', 'enterprise'}\n\ndef norm_name(value):\n    value = value.strip()\n    if not value:\n        return 'unknown'\n    return ' '.join(token[:1].upper() + token[1:].lower() for token in value.split())\n\ndef norm_email(value):\n    value = value.strip().lower()\n    if value.count('@') \"'!= 1 or '\"' ' in value:\n        return ''\n    local, domain = value.split('@')\n    if not local or '.' not in domain:\n        return ''\n    return value\n\ndef norm_date(value):\n    value = value.strip()\n    for fmt in formats:\n        try:\n            return datetime.strptime(value, fmt).strftime('%Y-%m-%d')\n        except ValueError:\n            pass\n    return ''\n\ndef norm_plan(value):\n    value = value.strip().lower()\n    return value if value in valid_plans else 'unknown'\n\ndef norm_mrr(value):\n    value = value.strip()\n    if not value or value.lower() == 'free':\n        return '0.00'\n    try:\n        amount = float(value.replace('\"'$'\"', '').replace(',', ''))\n    except ValueError:\n        return '0.00'\n    return '0.00' if amount < 0 else f'{amount:.2f}'\n\nwith src.open(newline='') as f:\n    rows = list(csv.DictReader(f))\n\nout = []\nfor row in rows:\n    plan = norm_plan(row['Plan'])\n    mrr = norm_mrr(row['MRR_USD'])\n    out.append({\n        'id': row['id'],\n        'name': norm_name(row['Name']),\n        'email': norm_email(row['Email']),\n        'signup_date': norm_date(row['SignupDate']),\n        'plan': plan,\n        'mrr_usd': mrr,\n    })\n\nout.sort(key=lambda r: (r['plan'], -float(r['mrr_usd']), r['email'], int(r['id'])))\nwith dst.open('w', newline='') as f:\n    writer = csv.DictWriter(f, fieldnames=['id', 'name', 'email', 'signup_date', 'plan', 'mrr_usd'], quoting=csv.QUOTE_NONE, lineterminator='\\\\n')\n    writer.writeheader()\n    writer.writerows(out)\n\nprint(f'normalized {len(rows)} rows -> {dst}')\nPY\npython3 - <<'PY'\nimport csv, re\nfrom pathlib import Path\np=Path('data/output.csv')\nwith p.open(newline='') as f:\n    rows=list(csv.DictReader(f))\nprint('rows:', len(rows))\nprint('header:', list(rows[0]) if rows else [])\nprint('field_counts:', sorted({len(r) for r in rows}))\nprint('bad_mrr:', sum(not re.fullmatch(r'\\\\d+\\\\.\\\\d{2}', r['mrr_usd']) for r in rows))\nprint('bad_dates:', sum(r['signup_date'] and not re.fullmatch(r'\\\\d{4}-\\\\d{2}-\\\\d{2}', r['signup_date']) for r in rows))\nprint('bad_plans:', sorted({r['plan'] for r in rows} - {'basic','pro','enterprise','unknown'}))\nprint('quoted_lines:', sum('\\\"' in line for line in p.read_text().splitlines()))\nprint('first_rows:')\nfor r in rows[:5]: print(r)\nprint('last_rows:')\nfor r in rows[-5:]: print(r)\n# independent sort check\nkey=lambda r:(r['plan'],-float(r['mrr_usd']),r['email'],int(r['id']))\nprint('sorted:', rows == sorted(rows,key=key))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
